<Application
    x:Class="InstantReplay.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="InstantReplay.GUI/Themes/Theme.xaml"/>
                <ResourceDictionary Source="InstantReplay.GUI/Themes/Density.xaml"/>
                <ResourceDictionary Source="InstantReplay.GUI/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Crisp text and images everywhere. TextOptions/RenderOptions are
                 inherited attached properties, so these flow into every control,
                 glyph and image (including WPF-UI's own templates) unless a child
                 explicitly overrides them. Display formatting pixel-snaps glyphs;
                 ClearType keeps subpixel antialiasing on the Mica-transparent
                 background; HighQuality adds proper filtering for scaled icons. -->

            <!-- Implicit TextBlock style (keeps WPF-UI's base style via BasedOn). -->
            <Style TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- WPF-UI v4.0.2+ calls SetResourceReference(StyleProperty, ...) in the
                 ui:TextBlock constructor, which wins over an implicit ui:TextBlock
                 style. Override the named typography styles after the dictionaries. -->
            <Style x:Key="BodyTextBlockStyle" TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Standard WPF controls (Buttons, TextBoxes, ComboBoxes, ...). -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>

            <!-- A single shared animated pill replaces each item's static indicator. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
