<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:InstantReplay.GUI.Controls"
        xmlns:models="clr-namespace:InstantReplay.Models"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        x:Class="InstantReplay.GUI.MainWindow"
        Title="Instant Replay"
        Width="760"
        Height="480"
        MinWidth="480"
        MinHeight="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Closing="Window_Closing"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid x:Name="RootGrid"
            Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                Grid.Row="0"
                ShowMaximize="False"
                CanMaximize="False"
                ShowMinimize="True"
                ShowClose="True"
                CloseWindowByDoubleClickOnIcon="False"
                ForceShutdown="False">
            <ui:TitleBar.TrailingContent>
                <StackPanel x:Name="TitleBarButtonsPanel"
                        Orientation="Horizontal">
                    <ui:Button x:Name="DonateTitleButton"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            IsTabStop="False"
                            Click="DonateTitleButton_Click"
                            ToolTipService.ToolTip="Donate"
                            Width="44">
                        <TextBlock Text="&#128150;"
                                FontFamily="Segoe UI Emoji"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </ui:Button>
                    <ui:Button x:Name="GitHubTitleButton"
                            Style="{StaticResource TitleBarIconButtonStyle}"
                            IsTabStop="False"
                            Click="GitHubTitleButton_Click"
                            ToolTipService.ToolTip="View on GitHub"
                            Width="44">
                        <Image Source="{DynamicResource GitHubLogoSource}"
                                Width="18"
                                Height="18"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <ui:InfoBar x:Name="WebViewRequirementBar"
                Visibility="Collapsed"
                Grid.Row="1"
                Margin="12,8,12,0"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Title="WebView2 is required for playback"
                Message="The media player will not work without the WebView2 Runtime.">
            <ui:Button Content="Download WebView2"
                    Click="DownloadWebView2Button_Click"/>
        </ui:InfoBar>

        <Grid x:Name="NavRoot"
                Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="NavPane"
                    Grid.Column="0"
                    Width="220"
                    Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ui:Button x:Name="NavPaneToggle"
                        Grid.Row="0"
                        Width="40"
                        Height="36"
                        Margin="4,2,0,4"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="NavPaneToggle_Click"
                        IsTabStop="False"
                        AutomationProperties.Name="Toggle navigation pane"
                        ToolTipService.ToolTip="Navigation">
                    <ui:FontIcon Glyph="&#59136;"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"/>
                </ui:Button>
                <StackPanel Grid.Row="1"
                        Margin="0,4,0,0">
                    <RadioButton x:Name="NavHomeItem"
                            Tag="Home"
                            GroupName="MainNav"
                            Style="{StaticResource NavItemStyle}"
                            Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="NavHomeItemIcon"
                                    Glyph="&#59407;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Width="32"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavHomeItemLabel"
                                    Text="Home"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Ellipse x:Name="NavHomeItemBadge"
                                    Width="8"
                                    Height="8"
                                    Margin="8,0,0,0"
                                    Fill="#E81123"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGalleryItem"
                            Tag="Gallery"
                            GroupName="MainNav"
                            Style="{StaticResource NavItemStyle}"
                            Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="NavGalleryItemIcon"
                                    Glyph="&#59577;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Width="32"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavGalleryItemLabel"
                                    Text="Gallery"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Ellipse x:Name="NavGalleryItemBadge"
                                    Width="8"
                                    Height="8"
                                    Margin="8,0,0,0"
                                    Fill="#E81123"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGamesItem"
                            Tag="Games"
                            GroupName="MainNav"
                            Style="{StaticResource NavItemStyle}"
                            Visibility="Collapsed"
                            Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="NavGamesItemIcon"
                                    Glyph="&#59388;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Width="32"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavGamesItemLabel"
                                    Text="Games"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Ellipse x:Name="NavGamesItemBadge"
                                    Width="8"
                                    Height="8"
                                    Margin="8,0,0,0"
                                    Fill="#E81123"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettingsItem"
                            Tag="Settings"
                            GroupName="MainNav"
                            Style="{StaticResource NavItemStyle}"
                            Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="NavSettingsItemIcon"
                                    Glyph="&#59155;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Width="32"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavSettingsItemLabel"
                                    Text="Settings"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Ellipse x:Name="NavSettingsItemBadge"
                                    Width="8"
                                    Height="8"
                                    Margin="8,0,0,0"
                                    Fill="#E81123"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2"
                        Margin="0,0,0,6">
                    <RadioButton x:Name="NavUpdatesItem"
                            Tag="Updates"
                            GroupName="MainNav"
                            Style="{StaticResource NavItemStyle}"
                            Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="NavUpdatesItemIcon"
                                    Glyph="&#59541;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Width="32"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavUpdatesItemLabel"
                                    Text="Updates"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Ellipse x:Name="NavUpdatesItemBadge"
                                    Width="8"
                                    Height="8"
                                    Margin="8,0,0,0"
                                    Fill="#E81123"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Single shared WinUI-style selection pill, animated between items. -->
                <Canvas x:Name="NavSelectionOverlay"
                        Grid.RowSpan="3"
                        IsHitTestVisible="False"
                        Panel.ZIndex="1">
                    <Border x:Name="SelectionPill"
                            Canvas.Left="4"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            Opacity="0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PillTransform" Y="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
            </Grid>
            <Grid Grid.Column="1">
                <Grid x:Name="PagesHost"
                        Margin="{StaticResource ContentFrameMargin}">

                    <Grid x:Name="HomePage"
                            Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="2*"
                                    MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="HeroCard"
                                Grid.Row="0"
                                CornerRadius="16"
                                BorderThickness="1"
                                Background="{DynamicResource StatCardBrush}"
                                BorderBrush="{DynamicResource StatCardBorderBrush}">
                            <Grid>
                                <Grid x:Name="HeroTopBar"
                                        VerticalAlignment="Top"
                                        Margin="20,16,20,0">
                                    <Border x:Name="StatusPill"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="10,4"
                                            CornerRadius="12"
                                            Background="#14FFFFFF"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="RecDot"
                                                    Width="7"
                                                    Height="7"
                                                    Fill="{DynamicResource TextMutedBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <TextBlock x:Name="StatusHeadline"
                                                    Text="STOPPED"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="HotkeyPill"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="12,5"
                                            CornerRadius="14"
                                            Background="#14FFFFFF"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                            <ui:FontIcon Glyph="&#59717;"
                                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="Hotkey:"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"/>
                                            <StackPanel x:Name="HotkeyKeys"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid x:Name="HeroContent"
                                        Margin="32,56,32,32"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="HeroArt"
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Viewbox x:Name="HeroIcon"
                                                Width="200"
                                                Height="160"
                                                Stretch="Uniform">
                                            <Canvas Width="120"
                                                    Height="96">
                                                <Rectangle Width="104"
                                                        Height="70"
                                                        Canvas.Left="8"
                                                        Canvas.Top="3"
                                                        RadiusX="9"
                                                        RadiusY="9"
                                                        StrokeThickness="5"
                                                        Stroke="{DynamicResource TextPrimaryBrush}"
                                                        Opacity="0.78"/>
                                                <Rectangle Width="14"
                                                        Height="11"
                                                        Canvas.Left="53"
                                                        Canvas.Top="76"
                                                        Fill="{DynamicResource TextPrimaryBrush}"
                                                        Opacity="0.78"/>
                                                <Rectangle Width="58"
                                                        Height="7"
                                                        Canvas.Left="31"
                                                        Canvas.Top="87"
                                                        RadiusX="3.5"
                                                        RadiusY="3.5"
                                                        Fill="{DynamicResource TextPrimaryBrush}"
                                                        Opacity="0.78"/>
                                                <Path Stroke="{DynamicResource AccentBrush}"
                                                        StrokeThickness="6"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round"
                                                        Data="M 45.3,31.5 A 17,17 0 1 1 43.7,45"/>
                                                <Polygon Fill="{DynamicResource AccentBrush}"
                                                        Points="36.5,45 50.5,45 43.5,34"/>
                                                <Ellipse Width="6"
                                                        Height="6"
                                                        Canvas.Left="95"
                                                        Canvas.Top="58"
                                                        Fill="{DynamicResource AccentBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>

                                    <Rectangle Grid.Column="1"
                                            Width="1"
                                            Margin="8,20"
                                            VerticalAlignment="Stretch"
                                            Fill="{DynamicResource StatCardBorderBrush}"/>

                                    <StackPanel Grid.Column="2"
                                            Margin="36,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroTitle"
                                                Text="Instant Replay"
                                                FontSize="42"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel x:Name="HeroSubtitle"
                                                Margin="0,6,0,0">
                                            <TextBlock Text="Record your last moments, instantly."
                                                    FontSize="19"
                                                    TextWrapping="Wrap"
                                                    Foreground="{DynamicResource StatHintBrush}"/>
                                            <TextBlock Text="Press the hotkey to save the last seconds of your screen."
                                                    FontSize="14"
                                                    TextWrapping="Wrap"
                                                    MaxWidth="360"
                                                    HorizontalAlignment="Left"
                                                    Foreground="{DynamicResource StatLabelBrush}"
                                                    Margin="0,12,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="HeroActions"
                                                Orientation="Horizontal"
                                                Margin="0,26,0,0">
                                            <ui:Button x:Name="SaveReplayButton"
                                                    controls:UiHover.IsEnabled="True"
                                                    Style="{StaticResource HomeAccentButtonStyle}"
                                                    Height="46"
                                                    MinWidth="160"
                                                    Padding="18,0"
                                                    CornerRadius="9"
                                                    IsEnabled="False"
                                                    Click="SaveReplayButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:FontIcon Glyph="&#59214;"
                                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                            FontSize="15"
                                                            Foreground="{Binding Foreground, ElementName=SaveReplayButton}"/>
                                                    <TextBlock Text="Save Replay"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding Foreground, ElementName=SaveReplayButton}"
                                                            Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="StartStopButton"
                                                    controls:UiHover.IsEnabled="True"
                                                    Style="{StaticResource HomeNeutralButtonStyle}"
                                                    Height="46"
                                                    MinWidth="140"
                                                    Padding="18,0"
                                                    CornerRadius="9"
                                                    Click="StartStopButton_Click"
                                                    Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:FontIcon x:Name="StartStopIcon"
                                                            Glyph="&#59240;"
                                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                            FontSize="15"
                                                            Foreground="{Binding Foreground, ElementName=StartStopButton}"/>
                                                    <TextBlock x:Name="StartStopText"
                                                            Text="Start Replay"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding Foreground, ElementName=StartStopButton}"
                                                            Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid x:Name="StatsRow"
                                Grid.Row="1"
                                Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CpuCard"
                                    Grid.Column="0"
                                    Style="{StaticResource StatCard}"
                                    MinHeight="0"
                                    Padding="20,14"
                                    VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CpuIconBg"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            BorderBrush="#26FFFFFF"
                                            VerticalAlignment="Center">
                                        <ui:FontIcon x:Name="CpuIconGlyph"
                                                Glyph="&#59728;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="24"
                                                Foreground="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                        <TextBlock Text="CPU Usage"
                                                FontSize="13"
                                                Foreground="{DynamicResource StatLabelBrush}"/>
                                        <TextBlock x:Name="CpuValueText"
                                                Text="&#8212;"
                                                FontSize="30"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Margin="0,2,0,0"/>
                                        <TextBlock x:Name="CpuHintText"
                                                Text="overall usage"
                                                FontSize="12"
                                                Foreground="{DynamicResource StatHintBrush}"
                                                Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid x:Name="CpuSparkHost"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            SizeChanged="SparkHost_SizeChanged"
                                            Margin="16,0,0,0">
                                        <Polygon x:Name="CpuSparkArea"
                                                Opacity="0.18"
                                                Fill="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"/>
                                        <Polyline x:Name="CpuSparkLine"
                                                Stroke="{DynamicResource AccentBrush}"
                                                StrokeThickness="2"
                                                StrokeLineJoin="Round"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="RamCard"
                                    Grid.Column="1"
                                    Style="{StaticResource StatCard}"
                                    MinHeight="0"
                                    Padding="20,14"
                                    VerticalAlignment="Stretch"
                                    Margin="16,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RamIconBg"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="12"
                                            BorderThickness="1"
                                            BorderBrush="#26FFFFFF"
                                            VerticalAlignment="Center">
                                        <ui:FontIcon x:Name="RamIconGlyph"
                                                Glyph="&#61088;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="24"
                                                Foreground="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                        <TextBlock Text="Memory Usage"
                                                FontSize="13"
                                                Foreground="{DynamicResource StatLabelBrush}"/>
                                        <TextBlock x:Name="RamValueText"
                                                Text="&#8212;"
                                                FontSize="30"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Margin="0,2,0,0"/>
                                        <TextBlock x:Name="RamHintText"
                                                Text="memory in use"
                                                FontSize="12"
                                                Foreground="{DynamicResource StatHintBrush}"
                                                Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Grid x:Name="RamSparkHost"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            SizeChanged="SparkHost_SizeChanged"
                                            Margin="16,0,0,0">
                                        <Polygon x:Name="RamSparkArea"
                                                Opacity="0.18"
                                                Fill="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"/>
                                        <Polyline x:Name="RamSparkLine"
                                                Stroke="{DynamicResource AccentBrush}"
                                                StrokeThickness="2"
                                                StrokeLineJoin="Round"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="GalleryPage"
                            Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="GalleryHeader"
                                Margin="0,0,0,14">
                            <TextBlock Text="Gallery"
                                    Style="{StaticResource Title}"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="GalleryCountText"
                                    Style="{StaticResource Caption}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid x:Name="GalleryBody"
                                Grid.Row="1">
                            <ListBox x:Name="GalleryGrid"
                                    SelectionMode="Single"
                                    Padding="8,8,10,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    ScrollViewer.CanContentScroll="True"
                                    SelectionChanged="GalleryGrid_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ui:VirtualizingWrapPanel ItemSize="266,156"
                                                SpacingMode="None"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin"
                                                Value="0,0,14,14"/>
                                        <Setter Property="Padding"
                                                Value="0"/>
                                        <Setter Property="Focusable"
                                                Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardRoot"
                                                Width="252"
                                                Height="142"
                                                CornerRadius="10"
                                                Background="{DynamicResource SettingsAreaBrush}"
                                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                BorderThickness="1"
                                                RenderTransformOrigin="0.5,0.5"
                                                Loaded="CardRoot_Loaded">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Border Background="{DynamicResource HoverBrush}"
                                                        CornerRadius="10">
                                                    <ui:FontIcon Glyph="&#59156;"
                                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                            FontSize="28"
                                                            Opacity="0.35"/>
                                                </Border>
                                                <Border x:Name="ThumbImage"
                                                        CornerRadius="10">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border Width="44"
                                                        Height="44"
                                                        CornerRadius="22"
                                                        Background="#80000000"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <ui:FontIcon Glyph="&#59240;"
                                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                            FontSize="16"
                                                            Foreground="White"/>
                                                </Border>
                                                <Grid x:Name="CardDetails"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                    <Border Background="#99000000"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Margin="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding SizeText}"
                                                                FontSize="12"
                                                                Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#99000000"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Margin="8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Fps}"
                                                                FontSize="12"
                                                                Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#99000000"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Margin="8"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding DurationText}"
                                                                FontSize="12"
                                                                Foreground="White"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal"
                                                            Margin="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom">
                                                        <ui:Button Width="34"
                                                                Height="34"
                                                                Padding="0"
                                                                CornerRadius="17"
                                                                Background="#A6000000"
                                                                Foreground="White"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="More options"
                                                                Click="CardMoreButton_Click">
                                                            <ui:FontIcon Glyph="&#59154;"
                                                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                    FontSize="14"/>
                                                        </ui:Button>
                                                        <ui:Button Width="34"
                                                                Height="34"
                                                                Padding="0"
                                                                CornerRadius="17"
                                                                Background="#A6000000"
                                                                Foreground="White"
                                                                Tag="{Binding}"
                                                                Margin="6,0,0,0"
                                                                ToolTipService.ToolTip="Show in File Explorer"
                                                                Click="CardOpenFolderButton_Click">
                                                            <ui:FontIcon Glyph="&#59448;"
                                                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                    FontSize="14"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="CardRoot"
                                                    Property="IsMouseOver"
                                                    Value="True">
                                                <Setter TargetName="CardDetails"
                                                        Property="IsHitTestVisible"
                                                        Value="True"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                    Storyboard.TargetProperty="ScaleX"
                                                                    To="1.03"
                                                                    Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                    Storyboard.TargetProperty="ScaleY"
                                                                    To="1.03"
                                                                    Duration="0:0:0.14">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CardDetails"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.11"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                    Storyboard.TargetProperty="ScaleX"
                                                                    To="1"
                                                                    Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                                    Storyboard.TargetProperty="ScaleY"
                                                                    To="1"
                                                                    Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="CardDetails"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:0.09"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="GalleryEmptyState"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                <Image Width="42"
                                        Height="42"
                                        Source="pack://siteoforigin:,,,/assets/icons/icon.png"
                                        Stretch="Uniform"
                                        Opacity="0.38"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="No Clips Yet"
                                        Style="{StaticResource Title}"
                                        Opacity="0.55"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ViewerPage"
                            Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ui:Button x:Name="ViewerBackButton"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="36"
                                Padding="14,0"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Left"
                                Click="ViewerBackButton_Click">
                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#59179;"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Foreground="{Binding Foreground, ElementName=ViewerBackButton}"/>
                                <TextBlock Text="Back to gallery"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=ViewerBackButton}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </ui:Button>

                        <Grid x:Name="PlayerViewport"
                                Grid.Row="1"
                                SizeChanged="PlayerViewport_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PlayerCard"
                                    Background="Black"
                                    CornerRadius="12"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Grid x:Name="InlinePlayerHost">
                                    <Image x:Name="ViewerPoster"
                                            Stretch="Uniform"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="GamesPage"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="980"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Games"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                <ui:Button Grid.Column="1"
                                        Click="AddGame_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#59152;"
                                                FontSize="14"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"/>
                                        <TextBlock Text="Add"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                            <TextBlock Text="Capture requires a match in the built-in or custom games list and a window in foreground focus. Add custom apps by executable name, with an optional title keyword."
                                    TextWrapping="Wrap"
                                    Opacity="0.75"
                                    Margin="0,16,0,0"/>
                            <ui:InfoBar x:Name="GameInfoBar1"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Focus controls capture"
                                    Message="Killing The Game Clears The Buffer Automatically And Changing Focus To Any Other App Will Pause The Buffer. The Buffer Will Be Unpaused When You Return Focus On The Same Game."
                                    Margin="0,16,0,0">
                                <ui:Button Content="Dismiss"
                                        Click="DismissGameInfoBar1_Click"/>
                            </ui:InfoBar>
                            <ui:InfoBar x:Name="GameInfoBar2"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Built-in games"
                                    Margin="0,16,0,0">
                                <ui:Button Content="Dismiss"
                                        Click="DismissGameInfoBar2_Click"/>
                            </ui:InfoBar>
                            <TextBlock Text="Your apps"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Margin="0,16,0,0"/>
                            <StackPanel x:Name="GamesEmptyState"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Margin="0,24,0,8">
                                <ui:FontIcon Glyph="&#59388;"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="42"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Opacity="0.38"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="No Custom Games Yet"
                                        Style="{StaticResource Title}"
                                        Opacity="0.55"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"/>
                            </StackPanel>
                            <ItemsControl x:Name="CustomGamesList"
                                    Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingsCard}"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                            FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                            TextWrapping="Wrap"
                                                            Opacity="0.7"
                                                            Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1"
                                                        Content="Remove"
                                                        Tag="{Binding}"
                                                        Click="RemoveGame_Click"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="UpdatesPage"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="UpdatesContent"
                                MaxWidth="980"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Updates"
                                        FontSize="28"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCard}"
                                    Padding="24"
                                    Margin="0,20,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SurfaceBorderBrush}"
                                                CornerRadius="12"
                                                Width="56"
                                                Height="56">
                                            <ui:FontIcon x:Name="UpdateIcon"
                                                    Glyph="&#59541;"
                                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                    FontSize="26"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <ui:FontIcon.RenderTransform>
                                                    <RotateTransform x:Name="UpdateIconRotation"/>
                                                </ui:FontIcon.RenderTransform>
                                            </ui:FontIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="18,0,0,0">
                                            <TextBlock x:Name="UpdateHeading"
                                                    Text="Keep Instant Replay up to date"
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"/>
                                            <TextBlock x:Name="UpdateDescription"
                                                    TextWrapping="Wrap"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,18,0,0">
                                        <ui:Button x:Name="CheckUpdatesButton"
                                                Content="Check for updates"
                                                Click="CheckUpdates_Click"/>
                                        <ui:Button x:Name="InstallUpdateButton"
                                                Content="Download and install"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="Collapsed"
                                                Click="InstallUpdate_Click"
                                                Margin="12,0,0,0"/>
                                        <ui:Button x:Name="CancelUpdateButton"
                                                Content="Cancel download"
                                                Visibility="Collapsed"
                                                Click="CancelUpdate_Click"
                                                Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="UpdateProgress"
                                            Visibility="Collapsed"
                                            Maximum="100"
                                            Margin="0,18,0,0"/>
                                    <ui:InfoBar x:Name="UpdateStatusBar"
                                            IsOpen="False"
                                            IsClosable="False"
                                            Margin="0,18,0,0"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="InstalledVersionLabel"
                                                Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock x:Name="LastUpdateCheckLabel"
                                                Grid.Column="1"
                                                Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ReleaseNotesCard"
                                    Style="{StaticResource SettingsCard}"
                                    Visibility="Collapsed"
                                    Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="What's new"
                                            FontSize="18"
                                            FontWeight="SemiBold"/>
                                    <TextBox x:Name="UpdateReleaseNotes"
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Padding="0"
                                            Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto"
                            Padding="0,0,12,0">
                        <StackPanel x:Name="SettingsContent">
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">
                                        <ui:FontIcon Glyph="&#59663;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource ErrorBrush}"/>
                                        <TextBlock Text="Replay target"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsAreaTextBrush}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <controls:SettingRow Label="Capture target"
                                            Margin="0,0,0,6">
                                        <ComboBox x:Name="CaptureTargetCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="CaptureTargetCombo_SelectionChanged">
                                            <ComboBoxItem Content="Whole desktop"/>
                                            <ComboBoxItem Content="Game Capture"/>

                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow x:Name="CaptureMonitorRow"
                                            Label="Display"
                                            Margin="0,0,0,6">
                                        <ComboBox x:Name="CaptureMonitorCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="CaptureMonitorCombo_SelectionChanged"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow x:Name="CaptureMethodRow"
                                            Label="Capture method"
                                            ToolTipService.ToolTip="Windows Graphics Capture targets windows and supports per-window options. DXGI duplication captures the whole display."
                                            Margin="0,0,0,6">
                                        <ComboBox x:Name="CaptureMethodCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="CaptureMethodCombo_SelectionChanged">
                                            <ComboBoxItem Content="DXGI duplication"/>
                                            <ComboBoxItem Content="Windows Graphics Capture"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <TextBlock x:Name="CaptureOptionsNote"
                                            Text="Show mouse cursor and Only client area affect Windows Graphics Capture only. DXGI duplication always captures the whole display."
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Margin="0,0,0,10"/>
                                    <controls:SettingRow Label="Show mouse cursor"
                                            Margin="0,0,0,6">
                                        <CheckBox x:Name="CaptureCursorCheck"
                                                AutomationProperties.Name="Show mouse cursor in recordings"
                                                Checked="WindowCaptureOption_Changed"
                                                Unchecked="WindowCaptureOption_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Only client area"
                                            Margin="0,0,0,6">
                                        <CheckBox x:Name="CaptureClientAreaCheck"
                                                AutomationProperties.Name="Capture only the client area"
                                                Checked="WindowCaptureOption_Changed"
                                                Unchecked="WindowCaptureOption_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Capture border"
                                            Margin="0,0,0,6">
                                        <CheckBox x:Name="CaptureBorderCheck"
                                                IsEnabled="False"
                                                Checked="WindowCaptureOption_Changed"
                                                Unchecked="WindowCaptureOption_Changed"/>
                                    </controls:SettingRow>

                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                        <ui:FontIcon Glyph="&#59155;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Video quality"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsAreaTextBrush}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <controls:SettingRow Label="Replay duration"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="DurationCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="DurationCombo_SelectionChanged">
                                            <ComboBoxItem Content="30 seconds"/>
                                            <ComboBoxItem Content="60 seconds"/>
                                            <ComboBoxItem Content="120 seconds"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Frame rate"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="FpsCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="FpsCombo_SelectionChanged">
                                            <ComboBoxItem Content="30 FPS"/>
                                            <ComboBoxItem Content="60 FPS"/>
                                            <ComboBoxItem Content="120 FPS"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Quality"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="QualityCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="QualityCombo_SelectionChanged">
                                            <ComboBoxItem Content="Ultra fast"/>
                                            <ComboBoxItem Content="Very fast"/>
                                            <ComboBoxItem Content="Fast"/>
                                            <ComboBoxItem Content="Balanced"/>
                                            <ComboBoxItem Content="Slow"/>
                                            <ComboBoxItem Content="Slower"/>
                                            <ComboBoxItem Content="Slowest"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Video codec"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="CodecCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="CodecCombo_SelectionChanged">
                                            <ComboBoxItem Content="H.264"/>
                                            <ComboBoxItem Content="HEVC / H.265"/>
                                            <ComboBoxItem Content="AV1"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Buffer"
                                            ToolTipService.ToolTip="Continuous keeps one rolling replay. Segmented saves one clip per second and is better for games that change scenes often."
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="BufferMethodCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="BufferMethodCombo_SelectionChanged">
                                            <ComboBoxItem Content="Continuous"/>
                                            <ComboBoxItem Content="Segmented"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="GPU"
                                            ToolTipService.ToolTip="Use hardware MFTs for encoding. Turn off to use the software encoder."
                                            Margin="0,0,0,8">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="GpuEncoderCheck"
                                                    Grid.Column="0"
                                                    AutomationProperties.Name="GPU encoder"
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    Checked="GpuEncoder_Changed"
                                                    Unchecked="GpuEncoder_Changed"/>
                                            <ComboBox x:Name="GpuPreferenceCombo"
                                                    Grid.Column="2"
                                                    Width="140"
                                                    MaxWidth="140"
                                                    HorizontalAlignment="Left"
                                                    SelectionChanged="GpuPreferenceCombo_SelectionChanged">
                                                <ComboBoxItem Content="Prefer iGPU"/>
                                                <ComboBoxItem Content="Prefer dGPU"/>
                                            </ComboBox>
                                        </Grid>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Bitrate (calculated)"
                                            ToolTipService.ToolTip="Calculated from quality preset, frame rate and capture resolution. Used as the target for both CBR and VBR."
                                            Margin="0">
                                        <TextBlock x:Name="BitrateValueText"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                        <ui:FontIcon Glyph="&#59155;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Audio"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsAreaTextBrush}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="Microphone"
                                            Style="{StaticResource Mono}"
                                            Margin="0,0,0,8"/>
                                    <ComboBox x:Name="MicCombo"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="MicCombo_SelectionChanged"
                                            Margin="0,0,0,14"/>

                                    <controls:SettingRow Label="Record microphone"
                                            Margin="0,0,0,8">
                                        <ui:ToggleSwitch x:Name="MicToggle"
                                                OnContent=""
                                                OffContent=""
                                                Checked="MicToggle_Changed"
                                                Unchecked="MicToggle_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow x:Name="RecordAudioRow"
                                            Label="Record system audio"
                                            Margin="0,0,0,8">
                                        <ui:ToggleSwitch x:Name="SysAudioToggle"
                                                OnContent=""
                                                OffContent=""
                                                Checked="SysAudioToggle_Changed"
                                                Unchecked="SysAudioToggle_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Application local audio"
                                            Margin="0,0,0,8">
                                        <ui:ToggleSwitch x:Name="ApplicationLocalAudioToggle"
                                                OnContent=""
                                                OffContent=""
                                                Checked="ApplicationLocalAudioToggle_Changed"
                                                Unchecked="ApplicationLocalAudioToggle_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Audio codec"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="AudioCodecCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="AudioCodecCombo_SelectionChanged">
                                            <ComboBoxItem Content="AAC"/>
                                            <ComboBoxItem Content="FLAC"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                    <controls:SettingRow x:Name="AudioBitrateRow"
                                            Label="Audio bitrate"
                                            Margin="0,0,0,8">
                                        <ComboBox x:Name="AudioBitrateCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="AudioBitrateCombo_SelectionChanged">
                                            <ComboBoxItem Content="96 kbps"/>
                                            <ComboBoxItem Content="128 kbps"/>
                                            <ComboBoxItem Content="160 kbps"/>
                                            <ComboBoxItem Content="192 kbps"/>
                                        </ComboBox>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                        <ui:FontIcon Glyph="&#59575;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Storage and hotkeys"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsAreaTextBrush}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="Save location"
                                            Style="{StaticResource Mono}"
                                            Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SaveLocationBox"
                                                Grid.Column="0"
                                                Height="32"
                                                VerticalContentAlignment="Center"
                                                TextChanged="SaveLocationBox_TextChanged"/>
                                        <ui:Button x:Name="BrowseSaveLocationButton"
                                                controls:UiHover.IsEnabled="True"
                                                Grid.Column="2"
                                                Height="32"
                                                Padding="16,0"
                                                HorizontalAlignment="Stretch"
                                                Click="BrowseSaveLocationButton_Click">
                                            <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                                <ui:FontIcon Glyph="&#59448;"
                                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{Binding Foreground, ElementName=BrowseSaveLocationButton}"/>
                                                <TextBlock Text="Browse"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding Foreground, ElementName=BrowseSaveLocationButton}"
                                                        Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>

                                    <controls:SettingRow Label="Save replay hotkey"
                                            Margin="0">
                                        <ui:Button x:Name="HotkeyCaptureButton"
                                                controls:UiHover.IsEnabled="True"
                                                Height="32"
                                                Padding="16,0"
                                                HorizontalAlignment="Stretch"
                                                Click="HotkeyCaptureButton_Click">
                                            <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                                <ui:FontIcon Glyph="&#59237;"
                                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{Binding Foreground, ElementName=HotkeyCaptureButton}"/>
                                                <TextBlock x:Name="HotkeyCaptureText"
                                                        Text="CTRL + *"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding Foreground, ElementName=HotkeyCaptureButton}"
                                                        Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                        <ui:FontIcon Glyph="&#59249;"
                                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="App"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsAreaTextBrush}"
                                                Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <controls:SettingRow Label="Start with Windows"
                                            Margin="0,0,0,8">
                                        <ui:ToggleSwitch x:Name="StartupToggle"
                                                OnContent=""
                                                OffContent=""
                                                Checked="StartupToggle_Changed"
                                                Unchecked="StartupToggle_Changed"/>
                                    </controls:SettingRow>
                                    <controls:SettingRow Label="Debug logging"
                                            ToolTipService.ToolTip="Writes detailed capture diagnostics to a debug log in the temporary folder."
                                            Margin="0,0,0,8">
                                        <ui:ToggleSwitch x:Name="DebugLoggingToggle"
                                                OnContent=""
                                                OffContent=""
                                                Checked="DebugLoggingToggle_Changed"
                                                Unchecked="DebugLoggingToggle_Changed"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ui:InfoBar x:Name="StatusInfoBar"
                        Canvas.ZIndex="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Margin="20,0,20,12"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational"
                        Title=""
                        Message="">
                    <ui:Button Content=""
                            Visibility="Collapsed"
                            x:Name="StatusInfoActionButton"/>
                </ui:InfoBar>

                <Border x:Name="PendingChangesFlyout"
                        UseLayoutRounding="True"
                        Canvas.ZIndex="10"
                        Style="{StaticResource PendingChangesBar}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0"
                        Visibility="Collapsed"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <SolidColorBrush Color="#99202020"/>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PendingFlyoutSlide"
                                Y="-6"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#59322;"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Unsaved changes"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="{StaticResource BodyFontSize}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                        <ui:Button x:Name="PendingSaveButton"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Click="PendingSaveButton_Click"
                                ToolTipService.ToolTip="Save your changes and restart the capture engine">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#59214;"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="Save"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="PendingDiscardButton"
                                Style="{StaticResource BaseButtonStyle}"
                                VerticalAlignment="Center"
                                Click="PendingDiscardButton_Click"
                                ToolTipService.ToolTip="Discard your changes and restore the previous values">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#59213;"
                                        FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="Discard"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- WPF-UI Tray: Fluent animated context menu with glyphs. -->
        <tray:NotifyIcon x:Name="AppTrayIcon"
                         TooltipText="Instant Replay"
                         MenuOnRightClick="True"
                         FocusOnLeftClick="True"
                         LeftDoubleClick="TrayLeftDoubleClick"
                         MenuFontSize="14">
            <tray:NotifyIcon.Menu>
                <ContextMenu ContextMenuOpening="TrayMenu_Opening"
                             SnapsToDevicePixels="True"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             RenderOptions.ClearTypeHint="Enabled"
                             RenderOptions.BitmapScalingMode="HighQuality">
                    <ui:MenuItem x:Name="TrayStartupItem"
                                 Header="Start with Windows"
                                 IsCheckable="True"
                                 Click="TrayStartup_Click">
                        <ui:MenuItem.Icon>
                            <ui:FontIcon Glyph="&#xE7E8;"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="16"/>
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator/>
                    <ui:MenuItem Header="Save Replay" InputGestureText="Alt+S"
                                 Click="TraySaveReplay_Click">
                        <ui:MenuItem.Icon>
                            <ui:FontIcon Glyph="&#xE74E;"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="16"/>
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="Open Window" Click="TrayOpenWindow_Click">
                        <ui:MenuItem.Icon>
                            <ui:FontIcon Glyph="&#xE8A7;"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="16"/>
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator/>
                    <ui:MenuItem Header="Restart App" Click="TrayRestart_Click">
                        <ui:MenuItem.Icon>
                            <ui:FontIcon Glyph="&#xE72C;"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="16"/>
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator/>
                    <ui:MenuItem Header="Exit" Click="TrayExit_Click">
                        <ui:MenuItem.Icon>
                            <ui:FontIcon Glyph="&#xE8BB;"
                                         FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                         FontSize="16"/>
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
