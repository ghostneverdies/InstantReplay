<UserControl
        x:Class="InstantReplay.GUI.SupportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Background="Transparent">

        <Grid x:Name="RootGrid"
              Background="Transparent">
                <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBarStrip"
                      Grid.Row="0"
                      Background="Transparent">
                        <TextBlock Text="Support Instant Replay"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ui:Button x:Name="CloseDonateButton"
                                Width="46"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                IsTabStop="False"
                                Click="CloseDonateButton_Click"
                                ToolTipService.ToolTip="Close">
                                <ui:FontIcon Glyph="&#xE8BB;"
                                          FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                          FontSize="10"/>
                        </ui:Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                             >
                        <StackPanel MaxWidth="440"
                                    Margin="28,20,28,24">
                                <TextBlock Text="&#x1F496;"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="42"
                                          
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Mono}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="4,0,4,16"
                                           LineHeight="18">
                    <Run Text="Thanks for using Instant Replay! It honestly means a lot to me that you chose this app."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="I build and maintain it in my spare time and I want to keep it free for everyone. If it has helped you and you feel like supporting the work, any donation is appreciated. There is no pressure at all. Thank you for being here!"/>
                                </TextBlock>

                                <TextBlock Text="USDT &#x00B7; TRC-20"
                                           Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource DonateBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource SettingsAreaBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,0,0,12">
                                        <TextBlock x:Name="WalletAddressText"
                                                   Text="TBLWg9dJtimMijGJtSKGX61DtmZbYaDbkD"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="13"/>
                                </Border>
                                <ui:Button x:Name="CopyAddressButton"
                                        Content="COPY ADDRESS"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="CopyAddressButton_Click"/>
                                <TextBlock Text="Every donation goes back into keeping Instant Replay free for everyone."
                                           Style="{StaticResource Mono}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,16,0,0"/>
                        </StackPanel>
                </ScrollViewer>
        </Grid>
</UserControl>
