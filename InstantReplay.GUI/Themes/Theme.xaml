<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <SolidColorBrush x:Key="AccentBrush"
                         Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="AccentTextBrush"
                         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RecBrush"
                         Color="#B84A4F"/>
        <SolidColorBrush x:Key="HeartRedBrush"
                         Color="#ED4956"/>

        <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="BgBrush"
                                         Color="#00131116"/>
                        <SolidColorBrush x:Key="SurfaceBrush"
                                         Color="#661C1922"/>
                        <SolidColorBrush x:Key="SurfaceBorderBrush"
                                         Color="#702E2838"/>
                        <SolidColorBrush x:Key="HoverBrush"
                                         Color="#2C2C2C"/>
                        <SolidColorBrush x:Key="AccentDimBrush"
                                         Color="{ThemeResource SystemAccentColorDark2}"/>
                        <SolidColorBrush x:Key="ErrorBrush"
                                         Color="#F5A623"/>
                        <SolidColorBrush x:Key="TextPrimaryBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextMutedBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="DonateBrush"
                                         Color="#26A17B"/>
                        <SolidColorBrush x:Key="TitleBarHoverBrush"
                                         Color="#4C4C4C"/>
                        <SolidColorBrush x:Key="TitleBarPressedBrush"
                                         Color="#404040"/>
                        <SolidColorBrush x:Key="SettingsAreaBrush"
                                         Color="#702D2D2D"/>
                        <SolidColorBrush x:Key="SettingsAreaTextBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="SettingsAreaMutedBrush"
                                         Color="#D4D4D4"/>
                        <SolidColorBrush x:Key="SuccessBrush"
                                         Color="#4CC38A"/>
                        <SolidColorBrush x:Key="StatCardBrush"
                                         Color="#661F1F1F"/>
                        <SolidColorBrush x:Key="StatCardBorderBrush"
                                         Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="HomeBarTrackBrush"
                                         Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="StatLabelBrush"
                                         Color="#99FFFFFF"/>
                        <SolidColorBrush x:Key="StatHintBrush"
                                         Color="#CCFFFFFF"/>
                        <SolidColorBrush x:Key="HeroBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColorDark3}"/>
                        <SolidColorBrush x:Key="HeroBorderBrush"
                                         Color="#40FFFFFF"/>
                        <BitmapImage x:Key="GitHubLogoSource"
                                     UriSource="ms-appx:///assets/icons/github_dark_mode.png"/>
                        <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewContentBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewExpandedPaneBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewCollapsedPaneBackground"
                                        ResourceKey="BgBrush"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="BgBrush"
                                         Color="#00FFFFFF"/>
                        <SolidColorBrush x:Key="SurfaceBrush"
                                         Color="#8CFFFFFF"/>
                        <SolidColorBrush x:Key="SurfaceBorderBrush"
                                         Color="#80DAD2E8"/>
                        <SolidColorBrush x:Key="HoverBrush"
                                         Color="#E8E8E8"/>
                        <SolidColorBrush x:Key="AccentDimBrush"
                                         Color="{ThemeResource SystemAccentColorLight3}"/>
                        <SolidColorBrush x:Key="ErrorBrush"
                                         Color="#C4700A"/>
                        <SolidColorBrush x:Key="TextPrimaryBrush"
                                         Color="#000000"/>
                        <SolidColorBrush x:Key="TextMutedBrush"
                                         Color="#000000"/>
                        <SolidColorBrush x:Key="DonateBrush"
                                         Color="#1F8F6A"/>
                        <SolidColorBrush x:Key="TitleBarHoverBrush"
                                         Color="#E4E4E4"/>
                        <SolidColorBrush x:Key="TitleBarPressedBrush"
                                         Color="#D6D6D6"/>
                        <SolidColorBrush x:Key="SettingsAreaBrush"
                                         Color="#96FFFFFF"/>
                        <SolidColorBrush x:Key="SettingsAreaTextBrush"
                                         Color="#000000"/>
                        <SolidColorBrush x:Key="SettingsAreaMutedBrush"
                                         Color="#3B3B3B"/>
                        <SolidColorBrush x:Key="SuccessBrush"
                                         Color="#2F9E68"/>
                        <SolidColorBrush x:Key="StatCardBrush"
                                         Color="#80FFFFFF"/>
                        <SolidColorBrush x:Key="StatCardBorderBrush"
                                         Color="#26000000"/>
                        <SolidColorBrush x:Key="HomeBarTrackBrush"
                                         Color="#1F000000"/>
                        <SolidColorBrush x:Key="StatLabelBrush"
                                         Color="#8A000000"/>
                        <SolidColorBrush x:Key="StatHintBrush"
                                         Color="#B3000000"/>
                        <SolidColorBrush x:Key="HeroBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColorDark2}"/>
                        <SolidColorBrush x:Key="HeroBorderBrush"
                                         Color="#40FFFFFF"/>
                        <BitmapImage x:Key="GitHubLogoSource"
                                     UriSource="ms-appx:///assets/icons/github_light_mode.png"/>
                        <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewContentBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewExpandedPaneBackground"
                                        ResourceKey="BgBrush"/>
                        <StaticResource x:Key="NavigationViewCollapsedPaneBackground"
                                        ResourceKey="BgBrush"/>
                </ResourceDictionary>

        </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
