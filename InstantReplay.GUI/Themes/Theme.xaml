<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WPF has no per-theme ResourceDictionary.ThemeDictionaries and no SystemAccentColorDark2/Light3 style
         keys. The DarkPalette / LightPalette dictionaries below are not merged: AppTheme.Apply (App.xaml.cs)
         copies the active palette into Application.Resources, and rewrites the accent-derived brushes from the
         Windows accent palette. Every consumer uses DynamicResource so a theme or accent change repaints live. -->

    <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RecBrush" Color="#B84A4F"/>
    <SolidColorBrush x:Key="HeartRedBrush" Color="#ED4956"/>

    <!-- Placeholders; AppTheme.Apply overwrites these from the Windows accent palette. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#004E8C"/>
    <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#003A6A"/>

    <!-- Defaults (dark) so designer and first paint are never unresolved. -->
    <SolidColorBrush x:Key="BgBrush" Color="#00131116"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#661C1922"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#702E2838"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DonateBrush" Color="#26A17B"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#4C4C4C"/>
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#404040"/>
    <SolidColorBrush x:Key="SettingsAreaBrush" Color="#702D2D2D"/>
    <SolidColorBrush x:Key="SettingsAreaTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SettingsAreaMutedBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A"/>
    <SolidColorBrush x:Key="StatCardBrush" Color="#661F1F1F"/>
    <SolidColorBrush x:Key="StatCardBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HomeBarTrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="StatLabelBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="StatHintBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#40FFFFFF"/>
    <BitmapImage x:Key="GitHubLogoSource" UriSource="pack://siteoforigin:,,,/assets/icons/github_dark_mode.png"/>

    <ResourceDictionary x:Key="DarkPalette">
        <SolidColorBrush x:Key="BgBrush" Color="#00131116"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#661C1922"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#702E2838"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#F5A623"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DonateBrush" Color="#26A17B"/>
        <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#4C4C4C"/>
        <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#404040"/>
        <SolidColorBrush x:Key="SettingsAreaBrush" Color="#702D2D2D"/>
        <SolidColorBrush x:Key="SettingsAreaTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsAreaMutedBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A"/>
        <SolidColorBrush x:Key="StatCardBrush" Color="#661F1F1F"/>
        <SolidColorBrush x:Key="StatCardBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="HomeBarTrackBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="StatLabelBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="StatHintBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="HeroBorderBrush" Color="#40FFFFFF"/>
        <BitmapImage x:Key="GitHubLogoSource" UriSource="pack://siteoforigin:,,,/assets/icons/github_dark_mode.png"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="LightPalette">
        <SolidColorBrush x:Key="BgBrush" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#8CFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#80DAD2E8"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C4700A"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#000000"/>
        <SolidColorBrush x:Key="DonateBrush" Color="#1F8F6A"/>
        <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#E4E4E4"/>
        <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="SettingsAreaBrush" Color="#96FFFFFF"/>
        <SolidColorBrush x:Key="SettingsAreaTextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="SettingsAreaMutedBrush" Color="#3B3B3B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E68"/>
        <SolidColorBrush x:Key="StatCardBrush" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="StatCardBorderBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="HomeBarTrackBrush" Color="#1F000000"/>
        <SolidColorBrush x:Key="StatLabelBrush" Color="#8A000000"/>
        <SolidColorBrush x:Key="StatHintBrush" Color="#B3000000"/>
        <SolidColorBrush x:Key="HeroBorderBrush" Color="#40FFFFFF"/>
        <BitmapImage x:Key="GitHubLogoSource" UriSource="pack://siteoforigin:,,,/assets/icons/github_light_mode.png"/>
    </ResourceDictionary>

</ResourceDictionary>
