<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <sys:Double x:Key="SpacingXS">6</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">14</sys:Double>
    <sys:Double x:Key="SpacingXL">18</sys:Double>

    <Thickness x:Key="CardPadding">18</Thickness>

    <Thickness x:Key="ContentFrameMargin">20,16,20,12</Thickness>
    <Thickness x:Key="ApplyButtonMargin">20,0,20,12</Thickness>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="HelperFontSize">12</sys:Double>

    <sys:Double x:Key="DenseHeaderFontSize">12</sys:Double>
    <sys:Double x:Key="DenseCellFontSize">13</sys:Double>

    <sys:Double x:Key="StepperButtonSize">32</sys:Double>
    <sys:Double x:Key="NavItemHeight">40</sys:Double>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>

    <Style x:Key="DenseColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DenseHeaderFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="DenseCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DenseCellFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="DenseNumericCellStyle" TargetType="TextBlock" BasedOn="{StaticResource DenseCellStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    </Style>
    <Style x:Key="DenseSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DenseCellStyle}">
        <Setter Property="FontSize" Value="{StaticResource DenseHeaderFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="IconButtonLabelStyle" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="BodyStrong"/>
    </Style>

</ResourceDictionary>
