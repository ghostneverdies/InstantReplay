<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:InstantReplay.GUI.Controls">

        <ThemeResource x:Key="ButtonBackground"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ButtonBackgroundPointerOver"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ButtonBackgroundPressed"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ButtonForeground"
                       ResourceKey="TextPrimaryBrush"/>
        <ThemeResource x:Key="ButtonForegroundPointerOver"
                       ResourceKey="TextPrimaryBrush"/>
        <ThemeResource x:Key="ButtonForegroundPressed"
                       ResourceKey="TextPrimaryBrush"/>
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

        <ControlTemplate x:Key="DepthButtonTemplate"
                         TargetType="Button">
                <Grid x:Name="ButtonRoot"
                      Background="Transparent"
                      RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                                <CompositeTransform x:Name="RootTransform"/>
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1"
                                                                         Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1"
                                                                         Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="TranslateY"
                                                                         To="0"
                                                                         Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShadowBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.55"
                                                                         Duration="0:0:0.16"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.015"
                                                                         Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.015"
                                                                         Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="TranslateY"
                                                                         To="-1"
                                                                         Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.1"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShadowBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.8"
                                                                         Duration="0:0:0.15"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="0.985"
                                                                         Duration="0:0:0.09">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="0.985"
                                                                         Duration="0:0:0.09">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="TranslateY"
                                                                         To="1"
                                                                         Duration="0:0:0.09">
                                                                <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.04"
                                                                         Duration="0:0:0.09"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShadowBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.25"
                                                                         Duration="0:0:0.09"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                                         Storyboard.TargetProperty="TranslateY"
                                                                         To="0"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.42"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShadowBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.12"/>
                                                </Storyboard>
                                        </VisualState>
                                </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ShadowBorder"
                                Background="#A0000000"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0.55"
                                Margin="0,3,0,0"/>
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="0,0,0,2">
                                <Grid>
                                        <Border x:Name="HoverOverlay"
                                                Background="#FFFFFF"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Opacity="0"/>
                                        <Border Height="1"
                                                VerticalAlignment="Top"
                                                Background="#26FFFFFF"
                                                Margin="1,0,1,0"/>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                </Grid>
                        </Border>
                </Grid>
        </ControlTemplate>

        <Style x:Key="AccentButtonStyle"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource AccentTextBrush}"/>
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="Padding"
                        Value="{StaticResource ButtonPadding}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Template"
                        Value="{StaticResource DepthButtonTemplate}"/>
        </Style>

        <Style x:Key="BaseButtonStyle"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{ThemeResource SurfaceBorderBrush}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="Padding"
                        Value="{StaticResource ButtonPadding}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Template"
                        Value="{StaticResource DepthButtonTemplate}"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{ThemeResource RecBrush}"/>
                <Setter Property="Foreground"
                        Value="#FFFFFF"/>
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="Padding"
                        Value="{StaticResource ButtonPadding}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Template"
                        Value="{StaticResource DepthButtonTemplate}"/>
        </Style>

        <Style x:Key="TitleBarIconButtonStyle"
               TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Height"
                        Value="32"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="0"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Grid>
                                                <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Background"
                                                                                        Value="{ThemeResource TitleBarHoverBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Background"
                                                                                        Value="{ThemeResource TitleBarPressedBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Opacity"
                                                                                        Value="0.4"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="RootBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="{TemplateBinding CornerRadius}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          Foreground="{TemplateBinding Foreground}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Height"
                        Value="32"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="0"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Grid>
                                                <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Background"
                                                                                        Value="#C42B1C"/>
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                        Value="#FFFFFF"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Background"
                                                                                        Value="#B02418"/>
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                        Value="#FFFFFF"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootBorder.Opacity"
                                                                                        Value="0.4"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="RootBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="{TemplateBinding CornerRadius}">
                                                        <ContentPresenter x:Name="ContentPresenter"
                                                                          Content="{TemplateBinding Content}"
                                                                          Foreground="{TemplateBinding Foreground}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <ControlTemplate x:Key="HomeActionButtonTemplate"
                         TargetType="Button">
                <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.14"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.10"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.04"
                                                                         Duration="0:0:0.09"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.12"
                                                                         Duration="0:0:0.09"/>
                                                </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.14"/>
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.42"
                                                                         Duration="0:0:0.14"/>
                                                </Storyboard>
                                        </VisualState>
                                </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                        <Border x:Name="HoverOverlay"
                                                Background="#FFFFFF"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Opacity="0"/>
                                        <Border x:Name="PressOverlay"
                                                Background="#000000"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Opacity="0"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          Content="{TemplateBinding Content}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                        </Border>
                </Grid>
        </ControlTemplate>

        <Style x:Key="HomeActionButtonBase"
               TargetType="Button">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontSize"
                        Value="13"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Padding"
                        Value="18,0"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="BorderBrush"
                        Value="#2EFFFFFF"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="CornerRadius"
                        Value="9"/>
                <Setter Property="Template"
                        Value="{StaticResource HomeActionButtonTemplate}"/>
        </Style>

        <Style x:Key="HomeAccentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeActionButtonBase}">
                <Setter Property="Background"
                        Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource AccentTextBrush}"/>
        </Style>

        <Style x:Key="HomeNeutralButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeActionButtonBase}">
                <Setter Property="Background"
                        Value="#1FFFFFFF"/>
                <Setter Property="Foreground"
                        Value="#FFFFFF"/>
        </Style>

        <Style x:Key="HomeDangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeActionButtonBase}">
                <Setter Property="Background"
                        Value="{ThemeResource RecBrush}"/>
                <Setter Property="Foreground"
                        Value="#FFFFFF"/>
        </Style>

        <Style x:Key="StatCard"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource StatCardBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource StatCardBorderBrush}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="12"/>
                <Setter Property="Padding"
                        Value="18"/>
                <Setter Property="MinHeight"
                        Value="108"/>
        </Style>

        <ThemeResource x:Key="ComboBoxBackground"
                       ResourceKey="BgBrush"/>
        <ThemeResource x:Key="ComboBoxBackgroundPointerOver"
                       ResourceKey="BgBrush"/>
        <ThemeResource x:Key="ComboBoxForeground"
                       ResourceKey="TextPrimaryBrush"/>
        <ThemeResource x:Key="ComboBoxBorderBrush"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ComboBoxDropDownBackground"
                       ResourceKey="SurfaceBrush"/>
        <ThemeResource x:Key="ComboBoxItemBackgroundSelected"
                       ResourceKey="AccentDimBrush"/>
        <ThemeResource x:Key="ComboBoxItemForegroundSelected"
                       ResourceKey="TextPrimaryBrush"/>

        <ThemeResource x:Key="TextControlBackground"
                       ResourceKey="BgBrush"/>
        <ThemeResource x:Key="TextControlBackgroundPointerOver"
                       ResourceKey="BgBrush"/>
        <ThemeResource x:Key="TextControlBackgroundFocused"
                       ResourceKey="BgBrush"/>
        <ThemeResource x:Key="TextControlBorderBrush"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="TextControlBorderBrushPointerOver"
                       ResourceKey="AccentBrush"/>
        <ThemeResource x:Key="TextControlBorderBrushFocused"
                       ResourceKey="AccentBrush"/>
        <ThemeResource x:Key="TextControlForeground"
                       ResourceKey="TextPrimaryBrush"/>
        <ThemeResource x:Key="TextControlForegroundFocused"
                       ResourceKey="TextPrimaryBrush"/>

        <ThemeResource x:Key="ToggleSwitchFillOff"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ToggleSwitchFillOn"
                       ResourceKey="AccentBrush"/>
        <ThemeResource x:Key="ToggleSwitchFillOnPointerOver"
                       ResourceKey="AccentBrush"/>
        <ThemeResource x:Key="ToggleSwitchStrokeOff"
                       ResourceKey="SurfaceBorderBrush"/>
        <ThemeResource x:Key="ToggleSwitchStrokeOn"
                       ResourceKey="AccentBrush"/>
        <ThemeResource x:Key="ToggleSwitchKnobFillOff"
                       ResourceKey="TextMutedBrush"/>
        <ThemeResource x:Key="ToggleSwitchKnobFillOn"
                       ResourceKey="AccentTextBrush"/>

        <Style x:Key="NavItemStyle"
               TargetType="RadioButton">
                <Setter Property="Padding"
                        Value="8,0"/>
                <Setter Property="Height"
                        Value="{StaticResource NavItemHeight}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextMutedBrush}"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                        <Grid x:Name="LayoutRoot">
                                                <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="HoverBorder.Opacity"
                                                                                        Value="1"/>
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                        Value="{ThemeResource TextPrimaryBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="CheckStates">
                                                                <VisualState x:Name="Unchecked"/>
                                                                <VisualState x:Name="Checked">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="CheckBackground.Opacity"
                                                                                        Value="1"/>
                                                                                <Setter Target="AccentBar.Opacity"
                                                                                        Value="1"/>
                                                                                <Setter Target="ContentPresenter.Foreground"
                                                                                        Value="{ThemeResource AccentTextBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="SidebarStates">
                                                                <VisualState x:Name="SidebarExpanded">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="CheckBackground.Width"
                                                                                        Value="161"/>
                                                                                <Setter Target="HoverBorder.Width"
                                                                                        Value="161"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="SidebarCollapsed">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="CheckBackground.Width"
                                                                                        Value="40"/>
                                                                                <Setter Target="HoverBorder.Width"
                                                                                        Value="40"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Rectangle x:Name="HoverBorder"
                                                           RadiusX="8"
                                                           RadiusY="8"
                                                           Fill="{ThemeResource HoverBrush}"
                                                           Opacity="0"
                                                           HorizontalAlignment="Left"
                                                           Width="161"
                                                           Margin="0,3,0,3"/>
                                                <Rectangle x:Name="CheckBackground"
                                                           RadiusX="8"
                                                           RadiusY="8"
                                                           Fill="{ThemeResource AccentDimBrush}"
                                                           Opacity="0"
                                                           HorizontalAlignment="Left"
                                                           Width="161"
                                                           Margin="0,3,0,3"/>
                                                <Rectangle x:Name="AccentBar"
                                                           Width="3"
                                                           Height="22"
                                                           HorizontalAlignment="Left"
                                                           Margin="0,1,0,0"
                                                           Fill="{ThemeResource AccentBrush}"
                                                           RadiusX="1.5"
                                                           RadiusY="1.5"
                                                           Opacity="0"/>
                                                <ContentPresenter x:Name="ContentPresenter"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  Foreground="{TemplateBinding Foreground}"
                                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>
        <Style x:Key="Title"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontSize"
                        Value="20"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="Caption"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontWeight"
                        Value="Normal"/>
                <Setter Property="FontSize"
                        Value="{StaticResource CaptionFontSize}"/>
                <Setter Property="CharacterSpacing"
                        Value="30"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="Mono"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontWeight"
                        Value="Normal"/>
                <Setter Property="FontSize"
                        Value="{StaticResource BodyFontSize}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="Helper"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontWeight"
                        Value="Normal"/>
                <Setter Property="FontSize"
                        Value="{StaticResource HelperFontSize}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="Card"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource SettingsAreaBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource SurfaceBorderBrush}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="10"/>
                <Setter Property="Padding"
                        Value="{StaticResource CardPadding}"/>
        </Style>
        <Style x:Key="SettingsCard"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource SettingsAreaBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource SurfaceBorderBrush}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="10"/>
                <Setter Property="Padding"
                        Value="{StaticResource CardPadding}"/>
        </Style>

        <Style x:Key="PendingChangesBar"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource BgBrush}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Padding"
                        Value="14,8"/>
        </Style>

        <Style x:Key="SettingsCaption"
               TargetType="TextBlock"
               BasedOn="{StaticResource Caption}">
                <Setter Property="Foreground"
                        Value="{ThemeResource SettingsAreaTextBrush}"/>
                <Setter Property="CharacterSpacing"
                        Value="30"/>
        </Style>

        <Style TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe UI Variable"/>
                <Setter Property="FontWeight"
                        Value="Normal"/>
                <Setter Property="FontSize"
                        Value="{StaticResource BodyFontSize}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="controls:SettingRow">
                <Setter Property="Margin"
                        Value="0,0,0,12"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="controls:SettingRow">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{TemplateBinding Label}"
                                                           Style="{StaticResource Mono}"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

</ResourceDictionary>
