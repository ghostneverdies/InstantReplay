<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.6.0</Version>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InstantReplay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icons\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- VS Code's C# extension runs design-time builds in a loop. They must not
         launch cl.exe or copy native DLLs: overlapping native builds lock
         engine.obj and break the real build with C1083. Real dotnet build/run
         still rebuild and copy every native payload on every invocation. -->
    <SkipNativePayload Condition="'$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' == 'false'">true</SkipNativePayload>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\github_light_mode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\github_dark_mode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\games*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\games\**\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="mediaplayer\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(SkipNativePayload)' != 'true'">
    <!-- Native payload is always refreshed on real builds: an incremental MSBuild
         + PreserveNewest could leave a stale engine.dll after a native rebuild. -->
    <None Include="engine\bin\engine.dll" Link="engine\bin\engine.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="engine\hooks\bin\capture_hook.dll" Link="engine\hooks\bin\capture_hook.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="engine\hooks\bin\overlay_hook.dll" Link="engine\hooks\bin\overlay_hook.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- No Inputs/Outputs on real builds: dotnet build/run can never skip the
       native engine and leave a stale engine.dll behind the C++ sources. -->
  <Target Name="BuildNativeEngine" BeforeTargets="PrepareForBuild"
    Condition="'$(SkipNativePayload)' != 'true'">
    <MakeDir Directories="engine\bin" />
    <Exec Command="call &quot;$(MSBuildProjectDirectory)\engine\engine_core\build.bat&quot;" />
  </Target>

  <Target Name="ValidateNativePayload" BeforeTargets="PrepareForBuild"
    DependsOnTargets="BuildNativeEngine" Condition="'$(SkipNativePayload)' != 'true'">
    <Error Condition="!Exists('engine\bin\engine.dll')"
      Text="Native engine is missing: engine\bin\engine.dll" />
  </Target>

  <!-- No Inputs/Outputs on real builds: always rebuild the injected hooks too,
       so every native DLL in the output matches its source on each build/run. -->
  <Target Name="BuildHook" BeforeTargets="PrepareForBuild"
    Condition="'$(SkipNativePayload)' != 'true'">
    <Exec
      Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\engine\hooks\build.ps1&quot;" />
  </Target>


</Project>