<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.6.0</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>InstantReplay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icons\icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Page Remove="App.xaml" />
    <Page Update="InstantReplay.GUI\Themes\Theme.xaml" Link="Themes\Theme.xaml" />
    <Page Update="InstantReplay.GUI\Themes\Density.xaml" Link="Themes\Density.xaml" />
    <Page Update="InstantReplay.GUI\Themes\Styles.xaml" Link="Themes\Styles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\github_light_mode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\github_dark_mode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\icons\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\games*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\games\**\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="mediaplayer\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Native payload is always refreshed: an incremental MSBuild + PreserveNewest
         could leave a stale engine.dll in the output after a separate native build. -->
    <None Include="engine\bin\engine.dll" Link="engine\bin\engine.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="engine\hooks\bin\capture_hook.dll" Link="engine\hooks\bin\capture_hook.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="engine\hooks\bin\overlay_hook.dll" Link="engine\hooks\bin\overlay_hook.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- No Inputs/Outputs: always rebuild so dotnet build/run can never skip the
       native engine and leave a stale engine.dll behind the C++ sources. -->
  <Target Name="BuildNativeEngine" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="engine\bin" />
    <Exec Command="call &quot;$(MSBuildProjectDirectory)\engine\engine_core\build.bat&quot;" />
  </Target>

  <Target Name="ValidateNativePayload" BeforeTargets="PrepareForBuild"
    DependsOnTargets="BuildNativeEngine">
    <Error Condition="!Exists('engine\bin\engine.dll')"
      Text="Native engine is missing: engine\bin\engine.dll" />
  </Target>

  <!-- No Inputs/Outputs: always rebuild the injected hooks too, so every native
       DLL in the output matches its source on each build/run. -->
  <Target Name="BuildHook" BeforeTargets="PrepareForBuild">
    <Exec
      Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\engine\hooks\build.ps1&quot;" />
  </Target>

  <Target Name="ReorganizePublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishWinmd Include="$(PublishDir)*.winmd" />
      <_PublishSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>

    <MakeDir Directories="$(PublishDir)meta" />
    <MakeDir Directories="$(PublishDir)symbols" Condition="'@(_PublishSymbols)' != ''" />
    <MakeDir Directories="$(PublishDir)assets" Condition="Exists('$(PublishDir)icon.ico')" />

    <Move SourceFiles="@(_PublishWinmd)" DestinationFolder="$(PublishDir)meta" />
    <Move SourceFiles="@(_PublishSymbols)" DestinationFolder="$(PublishDir)symbols"
      Condition="'@(_PublishSymbols)' != ''" />
    <Move SourceFiles="$(PublishDir)icon.ico" DestinationFolder="$(PublishDir)assets"
      Condition="Exists('$(PublishDir)icon.ico')" />

    <Message Importance="high"
      Text="Publish layout reorganized: engine/, meta/, symbols/ (WinUI runtime and locale folders stay at root)." />
  </Target>

</Project>