# ---- .NET build output ----
bin/
obj/
publish/

# ---- Rust build output ----
# Unanchored so it also matches engine/core/target (a root-only `target/*` does not).
target/
target/*
*.rlib
*.rmeta

# Rust DLL copied to engine/ by the documented two-stage build (README "Build").
# Regenerated by `cargo build --release` + copy; never commit it.
engine/engine.dll

# FFmpeg binaries are downloaded (see README "Build"), never committed. The license file is.
engine/encoder/*.dll
engine/encoder/*.exe

# ---- Installer output ----
installer/*.exe

# ---- Local agent / tooling artifacts (not part of the build) ----
AGENTS.md
graphify-out/

# ---- Logs ----
*.log

# ---- IDE / OS noise ----
.vs/
*.user
*.suo
.DS_Store
Thumbs.db
