# ---- .NET build output ----
bin/
obj/
publish/
tests/
.vscode/

# ---- Rust build output ----
# Unanchored so it also matches engine/core/target (a root-only `target/*` does not).
target/
target/*
*.rlib
*.rmeta

# C++ engine DLL built by engine/engine_core/build.bat (README "Build").
engine/bin/engine.dll
engine/hooks/bin
engine/hooks/obj

# FFmpeg binaries are downloaded (see README "Build"), never committed. The license file is.
engine/encoder/*.dll
engine/encoder/*.exe
engine/encoder/sdk/
engine/engine_core/build/

# ---- Installer output ----
installer/*.exe

# ---- Local agent / tooling artifacts (not part of the build) ----
AGENTS.md
graphify-out/

# ---- Logs ----
*.log

# Local portable build archive (not a release asset in the repo)
/InstantReplay.zip

# ---- IDE / OS noise ----
.vs/
*.user
*.suo
.DS_Store
Thumbs.db
