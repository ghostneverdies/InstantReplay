<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RecBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="HeartRedBrush" Color="#ED4956"/>

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="#131116"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1922"/>
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2E2838"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="AccentDimBrush" Color="{ThemeResource SystemAccentColorDark2}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#F5A623"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DonateBrush" Color="#26A17B"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#DAD2E8"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="AccentDimBrush" Color="{ThemeResource SystemAccentColorLight3}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#C4700A"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#000000"/>
            <SolidColorBrush x:Key="DonateBrush" Color="#1F8F6A"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>