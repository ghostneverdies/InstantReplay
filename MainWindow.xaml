<Window
    x:Class="InstantReplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="NavSidebar" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="185"
                Background="{ThemeResource SurfaceBrush}" BorderThickness="0" CornerRadius="0,0,0,8">
            <Grid Margin="8,10,8,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="NavToggleButton" Grid.Row="0" Width="40" Height="38"
                        HorizontalAlignment="Left" Margin="0,0,0,10" Click="NavToggleButton_Click"
                        Style="{StaticResource BaseButtonStyle}" Background="Transparent">
                    <FontIcon Glyph="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Foreground="{ThemeResource TextPrimaryBrush}"/>
                </Button>

                <StackPanel Grid.Row="1" Spacing="2">
                    <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked" IsChecked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NavHomeLabel" Grid.Column="1" Text="Home" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NavSettingsLabel" Grid.Column="1" Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavAdvanced" GroupName="Nav" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="15" HorizontalAlignment="Center" Foreground="{ThemeResource ErrorBrush}"/>
                            <TextBlock x:Name="NavAdvancedLabel" Grid.Column="1" Text="Advanced" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <RadioButton x:Name="NavDonate" Grid.Row="2" GroupName="Nav" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x2665;" FontSize="18" Foreground="{ThemeResource HeartRedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavDonateLabel" Grid.Column="1" Text="Donate" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </RadioButton>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" Margin="24,20,24,16">

            <Grid x:Name="HomePage" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="26" Background="{ThemeResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="I N S T A N T   R E P L A Y" FontFamily="Segoe UI" FontSize="19"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{ThemeResource TextMutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock x:Name="StatusHeadline" Text="STOPPED" Style="{StaticResource Caption}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CURRENT SESSION" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Microphone" Style="{StaticResource Mono}"/>
                            <TextBlock x:Name="SessionMicText" Grid.Column="1" Text="—" Style="{StaticResource Mono}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Replay duration" Style="{StaticResource Mono}"/>
                            <TextBlock x:Name="SessionDurationText" Grid.Column="1" Text="—" Style="{StaticResource Mono}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frame rate" Style="{StaticResource Mono}"/>
                            <TextBlock x:Name="SessionFpsText" Grid.Column="1" Text="—" Style="{StaticResource Mono}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Quality" Style="{StaticResource Mono}"/>
                            <TextBlock x:Name="SessionQualityText" Grid.Column="1" Text="—" Style="{StaticResource Mono}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Save replay hotkey" Style="{StaticResource Mono}"/>
                            <TextBlock x:Name="SessionHotkeyText" Grid.Column="1" Text="—" Style="{StaticResource Mono}" Foreground="{ThemeResource AccentBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartStopButton" Grid.Column="0" Content="STOP" Width="100"
                            Style="{StaticResource BaseButtonStyle}" Click="StartStopButton_Click"/>
                    <Button x:Name="SaveReplayButton" Grid.Column="2" Content="SAVE REPLAY" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="SaveReplayButton_Click"/>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MICROPHONE" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="MicCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="MicCombo_SelectionChanged" Margin="0,0,0,18"/>

                            <TextBlock Text="REPLAY DURATION" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Border Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="Duration30" Grid.Column="0" GroupName="Duration" Content="30s" Style="{StaticResource SegmentButtonStyle}" Checked="DurationSegment_Checked"/>
                                    <RadioButton x:Name="Duration60" Grid.Column="1" GroupName="Duration" Content="60s" Style="{StaticResource SegmentButtonStyle}" Checked="DurationSegment_Checked"/>
                                    <RadioButton x:Name="Duration120" Grid.Column="2" GroupName="Duration" Content="120s" Style="{StaticResource SegmentButtonStyle}" Checked="DurationSegment_Checked"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="FRAME RATE" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Border Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="Fps30" Grid.Column="0" GroupName="FrameRate" Content="30 FPS" Style="{StaticResource SegmentButtonStyle}" Checked="FpsSegment_Checked"/>
                                    <RadioButton x:Name="Fps60" Grid.Column="1" GroupName="FrameRate" Content="60 FPS" Style="{StaticResource SegmentButtonStyle}" Checked="FpsSegment_Checked"/>
                                    <RadioButton x:Name="Fps120" Grid.Column="2" GroupName="FrameRate" Content="120 FPS" Style="{StaticResource SegmentButtonStyle}" Checked="FpsSegment_Checked"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="QUALITY" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Border Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="QualityFast" Grid.Column="0" GroupName="Quality" Content="Fast" Style="{StaticResource SegmentButtonStyle}" Checked="QualitySegment_Checked"/>
                                    <RadioButton x:Name="QualityBalanced" Grid.Column="1" GroupName="Quality" Content="Balanced" Style="{StaticResource SegmentButtonStyle}" Checked="QualitySegment_Checked"/>
                                    <RadioButton x:Name="QualityHigh" Grid.Column="2" GroupName="Quality" Content="Quality" Style="{StaticResource SegmentButtonStyle}" Checked="QualitySegment_Checked"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Higher quality uses more CPU while recording." Style="{StaticResource Mono}" FontSize="12" Margin="0,0,0,18"/>

                            <TextBlock Text="SAVE LOCATION" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SaveLocationBox" Grid.Column="0" TextChanged="SaveLocationBox_TextChanged"/>
                                <Button x:Name="BrowseSaveLocationButton" Grid.Column="2" Content="BROWSE" Style="{StaticResource BaseButtonStyle}" Click="BrowseSaveLocationButton_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SAVE REPLAY HOTKEY" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <Button x:Name="HotkeyCaptureButton" Grid.Column="1" Content="CTRL + *" Width="140" Style="{StaticResource BaseButtonStyle}" Click="HotkeyCaptureButton_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="START WITH WINDOWS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="StartupToggle_Changed"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TRANSPARENCY EFFECTS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="TransparencyToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="TransparencyToggle_Changed"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DARK MODE" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="ThemeToggle_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Height="8" Background="Transparent"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ADVANCED" Style="{StaticResource Caption}" Foreground="{ThemeResource ErrorBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Only change these if you know what they do — most people never need to."
                                   Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="FFMPEG PATH" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FFmpegPathBox" Grid.Column="0" TextChanged="FFmpegPathBox_TextChanged"/>
                            <Button x:Name="BrowseFFmpegButton" Grid.Column="2" Content="BROWSE" Style="{StaticResource BaseButtonStyle}" Click="BrowseFFmpegButton_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="6">
                            <TextBlock Text="AUDIO SYNC OFFSETS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <Border Width="15" Height="15" CornerRadius="8" Background="{ThemeResource SurfaceBorderBrush}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Shifts this audio track earlier or later relative to the video, in milliseconds. A positive value delays it; a negative value makes it play earlier (in advance).">
                                <TextBlock Text="?" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-1,0,0" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SYSTEM AUDIO OFFSET" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SysOffsetMinus" Content="&#x2212;" Style="{StaticResource StepperButtonStyle}" Click="SysOffsetMinus_Click"/>
                                <TextBlock x:Name="SysOffsetValue" Text="+0 ms" Style="{StaticResource Mono}" Width="66" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <Button x:Name="SysOffsetPlus" Content="+" Style="{StaticResource StepperButtonStyle}" Click="SysOffsetPlus_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MIC OFFSET" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MicOffsetMinus" Content="&#x2212;" Style="{StaticResource StepperButtonStyle}" Click="MicOffsetMinus_Click"/>
                                <TextBlock x:Name="MicOffsetValue" Text="+0 ms" Style="{StaticResource Mono}" Width="66" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <Button x:Name="MicOffsetPlus" Content="+" Style="{StaticResource StepperButtonStyle}" Click="MicOffsetPlus_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DEBUG LOGGING" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="DebugToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="DebugToggle_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="DonatePage" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="&#x2665;" FontSize="36" Foreground="{ThemeResource HeartRedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Support Instant Replay" FontFamily="Segoe UI" FontSize="17"
                                   Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap" TextAlignment="Center" Margin="10,0,10,20" LineHeight="19">
                            <Run Text="Thank you so much for using Instant Replay — genuinely, it means a lot that you're here."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="This app is free and built in my spare time. If it's been useful to you and you'd like to help keep it going, a small donation is always appreciated. No pressure at all — just send it if you're able and want to."/>
                        </TextBlock>

                        <TextBlock Text="USDT &#x00B7; TRC-20" Style="{StaticResource Caption}" Foreground="{ThemeResource DonateBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock x:Name="WalletAddressText" Text="TBLWg9dJtimMijGJtSKGX61DtmZbYaDbkD"
                                       Style="{StaticResource Mono}" Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>
                        </Border>
                        <Button x:Name="CopyAddressButton" Content="COPY ADDRESS" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="CopyAddressButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <Button x:Name="ApplyButton" Grid.Column="1" Grid.Row="1" Content="NO CHANGES PENDING" IsEnabled="False"
                Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch"
                Margin="24,0,24,16" Click="ApplyButton_Click"/>
    </Grid>
</Window>
